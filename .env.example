# 复制本文件为 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，绝不会提交进仓库。

# ---- 大模型（阿里云百炼，OpenAI 兼容端点）----
# 在百炼控制台申请：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your_key_here
# 模型抽象层：改这里即可切换厂商（DeepSeek/OpenAI 都有兼容端点）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-plus      # 对话模型；换成 qwen-turbo 更便宜（调试用）
EMBEDDING_MODEL=text-embedding-v4

# ---- MySQL（模块1 起用到）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=agenthub

# ---- Redis（模块4 起用到；Windows 开发期用移植版/Memurai）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- Chroma 向量库（模块2 起用到；本地目录持久化，/data 已 gitignore）----
CHROMA_DIR=./data/chroma

# ---- Go 切分微服务（模块2 起用到）----
CHUNKER_URL=http://127.0.0.1:8080

# ---- Elasticsearch（模块6 起用到；务必限制 JVM 内存）----
ES_HOST=http://127.0.0.1:9200